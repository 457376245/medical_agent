# Runtime / Server
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8090
UVICORN_RELOAD=true
LOG_LEVEL=INFO

# Worker / Concurrency
WORKER_THREAD_POOL_SIZE=16
MAX_CONCURRENT_TASKS=8

# MQ
MQ_CONSUMER_ENABLED=false
RABBITMQ_URL=amqp://root:root@192.168.31.101

# OpenAI Compatible LLM
OPENAI_BASE_URL=http://192.168.31.101:8317/v1
OPENAI_API_KEY=sk-blackandw
OPENAI_AGENT_MODEL=gpt-5.4
OPENAI_PARSE_MODEL=gpt-5.4
OPENAI_GENERATE_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0
OPENAI_REQUEST_TIMEOUT_SECONDS=90
OPENAI_SDK_RETRIES=2
OPENAI_TRUST_ENV=false
OPENAI_PROXY=
OPENAI_RETRY_WITH_ENV_PROXY=true

# OSS / Object Storage
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=medical-agent-hjh
OSS_ACCESS_KEY_ID=LTAI5tLnt6xinXHNShy5Es4z
OSS_ACCESS_KEY_SECRET=0fNTI0ALEaBkjP9TlPKD6arWyrtwIC

# Agent behavior
AGENT_MODEL=
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096
MAX_TOOL_ROUNDS=10
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Java context aggregation API
JAVA_API_BASE_URL=http://localhost:8080
JAVA_AGENT_CONTEXT_PATH=/internal/agent
JAVA_AGENT_CONTEXT_TIMEOUT_SECONDS=8
JAVA_AGENT_API_KEY=
JAVA_AGENT_API_KEY_HEADER=X-Internal-Api-Key

# HTTP / Proxy / CORS
LLM_PROXY_MODE=sanitize
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VISION_OCR_MAX_PAGES=3

# Provider resilience
PROVIDER_MAX_ATTEMPTS=4
PROVIDER_BACKOFF_BASE_SECONDS=1.0
PROVIDER_BACKOFF_FACTOR=2.0
PROVIDER_BACKOFF_JITTER_SECONDS=0.3

# Local persistence
DATA_DIR=data
CHECKPOINT_DB_PATH=data/checkpoints.db
MEMORY_DB_PATH=data/memory.db
